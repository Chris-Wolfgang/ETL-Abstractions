<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net462;net472;net48;net481;netstandard2.0;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- Lockstep with Wolfgang.Etl.Abstractions: built and released from the same repo under the same
         version and tag. The stream-only tier (#359): referenced by the stream-based ETL libraries
         (Csv, Json, Xml), never by Abstractions itself. -->
    <!-- ABI / binary-compatibility gate: off for the FIRST release, because there is no published
         baseline to compare against yet. Turn it on with PackageValidationBaselineVersion set to the
         first published version once that release is on NuGet (as ErrorPolicies did from 0.22.0). -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>$(AssemblyName)</Title>
    <Description>Named stream sources and destinations plus multi-stream extractor and loader base classes for stream-based Wolfgang.Etl libraries (CSV, JSON, XML). Built on Wolfgang.Etl.Abstractions.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ETL-Abstractions.png</PackageIcon>
    <PackageTags>ETL;Extract-Transform-Load;streams;multi-stream</PackageTags>
    <!-- PublicApiAnalyzers: an untracked public-API addition (RS0016), removal (RS0017) or duplicate
         entry (RS0025) fails the build, as in the other packages. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0025</WarningsAsErrors>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wolfgang.Etl.Abstractions.Streams.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ETL-Abstractions.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Etl.Abstractions\Wolfgang.Etl.Abstractions.csproj" />
  </ItemGroup>

  <!-- MultiStreamProgress derives from the Report record, and a derived record's <Clone>$ returns the
       derived type on net5.0+ (covariant returns) but the base type on net462 / netstandard2.0. That one
       line lives in a per-family PublicAPI pair; everything else is in the shared pair. -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))">
    <AdditionalFiles Include="PublicApi\modern\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicApi\modern\PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))">
    <AdditionalFiles Include="PublicApi\legacy\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicApi\legacy\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    Microsoft.Bcl.AsyncInterfaces: the runtime assembly is built into net8+, so pre-net8 TFMs get a full
    reference (IAsyncEnumerable / IAsyncDisposable). Same split as Wolfgang.Etl.Abstractions.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462' OR '$(TargetFramework)' == 'net472' OR '$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net481' OR '$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net5.0' OR '$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Analyzer PackageReferences are centralized in Directory.Build.props -->


</Project>
